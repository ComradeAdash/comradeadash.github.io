{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "lib": ["dom","es2017"],
        "rootDir": "src",
        "outDir": "dist",
        "noEmitOnError": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    }
}